APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

FRONTEND_URL=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=be_market_back
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Cookie domain for auth token (null = current domain; set to 'localhost' for local dev)
AUTH_COOKIE_DOMAIN=localhost

# Admin seeder credentials (used by database/seeders/AdminSeeder.php)
ADMIN_SEED_NAME=Admin
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=change_me

# Sanctum stateful domains must include the frontend origin in production.
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1

# Frontend API base URL (consumed by Vite as VITE_API_URL)
VITE_API_URL=http://localhost:8000

# Payment sandbox: true simulates successful mobile-money payments locally.
# Set to false in production once a real Mixx by Yas/Flooz provider is integrated.
PAYMENT_SANDBOX=true

# FedaPay payment provider configuration (used when PAYMENT_SANDBOX=false in production)
FEDEPAY_API_KEY=
FEDEPAY_BASE_URL=https://api.fedapay.com/v1
FEDEPAY_SANDBOX_BASE_URL=https://sandbox-api.fedapay.com/v1
PAYMENT_CALLBACK_URL=https://your-domain.com/api/payment/callback

# Payment callback secret: set a strong random string in production.
# The payment provider must send it in the X-Callback-Secret header.
PAYMENT_CALLBACK_SECRET=
