# =============================================================================
# .env.production.example — Modele de configuration PRODUCTION (Be-Market back)
# =============================================================================
# Copie ce fichier en ".env" sur le serveur de prod, puis remplis les valeurs.
# NE COMMITE JAMAIS le .env reel (il est deja dans .gitignore).
# Genere APP_KEY avec : php artisan key:generate
# =============================================================================

APP_NAME=BeMarket
# OBLIGATOIRE en prod : sinon deploy-backend.sh refuse de s'executer
APP_ENV=production
APP_KEY=
# OBLIGATOIRE : false en prod (sinon fuite d'infos sensibles)
APP_DEBUG=false
# URL publique reelle du backend (https)
APP_URL=https://api.tondomaine.com

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

# Cout de hachage bcrypt (12 ok ; monter si le serveur est puissant)
BCRYPT_ROUNDS=12

# En prod, garder un niveau de log raisonnable (pas "debug")
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# --- Base de donnees (identifiants de PROD, jamais ceux du local) ---
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=be_market_prod
DB_USERNAME=CHANGE_ME
DB_PASSWORD=CHANGE_ME

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
# Domaine des cookies (ex: .tondomaine.com)
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Mail (configurer un vrai provider SMTP en prod) ---
MAIL_MAILER=smtp
MAIL_HOST=CHANGE_ME
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME
MAIL_PASSWORD=CHANGE_ME
MAIL_FROM_ADDRESS="no-reply@tondomaine.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Stockage fichiers (S3 optionnel) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- CORS : UNIQUEMENT le(s) domaine(s) reel(s) du front (pas de localhost) ---
CORS_ALLOWED_ORIGINS=https://tondomaine.com,https://www.tondomaine.com

# --- Admin seeder ---
# NE PAS laisser un vrai mot de passe admin ici en prod.
# Recommande : creer l'admin une fois puis CHANGER son mot de passe hors .env.
ADMIN_SEED_NAME=Admin
ADMIN_SEED_EMAIL=CHANGE_ME
ADMIN_SEED_PASSWORD=CHANGE_ME

# --- Passport ---
# Les cles vivent dans storage/oauth-*.key (php artisan passport:keys, UNE fois,
# puis SAUVEGARDEES). Ne pas les regenerer en prod (invaliderait tous les tokens).
# PASSPORT_PRIVATE_KEY=
# PASSPORT_PUBLIC_KEY=
# PASSPORT_CONNECTION=

# --- Frontend API base URL (utilise par Vite au build du front) ---
VITE_API_URL=https://api.tondomaine.com

# --- Paiement : DOIT etre false en prod (sandbox = paiements simules) ---
PAYMENT_SANDBOX=false

# Secret partage pour securiser les callbacks du provider de paiement.
PAYMENT_CALLBACK_SECRET=CHANGE_ME
